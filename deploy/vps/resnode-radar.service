[Unit]
Description=ResNode Radar ten-minute collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=resnode-radar
Group=resnode-radar
WorkingDirectory=/opt/resnode-radar/current
Environment=NODE_ENV=production
Environment=MONITOR_GIT_PUSH=0
ExecStart=/opt/resnode-radar/node/bin/node scripts/monitor-daemon.mjs --interval 10
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/resnode-radar
StandardOutput=journal
StandardError=journal
SyslogIdentifier=resnode-radar

[Install]
WantedBy=multi-user.target
