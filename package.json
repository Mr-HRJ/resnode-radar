{
  "name": "resnode-radar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "VPS stock monitor and owner-run review site.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/contracts",
    "apps/collector",
    "apps/server",
    "apps/web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/majiayu000/resnode-radar.git"
  },
  "bugs": {
    "url": "https://github.com/majiayu000/resnode-radar/issues"
  },
  "scripts": {
    "test": "node --test packages/contracts/test/*.test.mjs apps/collector/test/*.test.mjs apps/server/test/*.test.mjs scripts/*.test.mjs && npm --workspace @resnode-radar/web run test && node apps/web/e2e/browser-e2e.mjs",
    "test:e2e": "node apps/web/e2e/browser-e2e.mjs",
    "check": "node scripts/check-workspace.mjs",
    "build": "npm run build:vps",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:vps": "node scripts/build-vps.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npx --yes wrangler@4.160.0 deploy",
    "assets": "node scripts/generate-assets.mjs",
    "monitor": "node scripts/monitor.mjs",
    "monitor:seed-v2": "node scripts/monitor.mjs --seed-v2-from-v1",
    "fx:update": "node scripts/fx-rates.mjs",
    "monitor:validate": "node scripts/validate-monitor-data.mjs",
    "monitor:sync": "npm run fx:update && npm run monitor && npm run monitor:validate",
    "monitor:daemon": "node scripts/monitor-daemon.mjs --interval 20",
    "start": "node scripts/monitor-daemon.mjs --serve --port 4173 --interval 20",
    "serve": "node scripts/monitor-daemon.mjs --serve --port 4173 --interval 20",
    "serve:static": "node scripts/serve-static.mjs --port 4173",
    "service:install": "node scripts/macos-service.mjs install",
    "service:status": "node scripts/macos-service.mjs status",
    "service:uninstall": "node scripts/macos-service.mjs uninstall"
  },
  "dependencies": {
    "impers": "0.1.3",
    "node-html-parser": "7.0.1"
  }
}
